# ── Argus 配置示例 ──────────────────────────────────────────────
# 复制为 .env 后按需填写：  cp .env.example .env
# 真值只放 .env（已 gitignore，绝不入库）。至少填 LLM_API_KEY；跑 Android 还需 ANDROID_PACKAGE。
# 也可 `python3 -m argus.cli init` 生成一份默认 .env。

# ── 平台 ──
PLATFORM=android                       # ios | android | browser | rdp

# ── LLM（OpenAI 兼容协议；默认 OpenRouter）──
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=                           # 必填；真值仅放本地 .env
LLM_MODEL=google/gemini-3.5-flash      # 主多模态模型；所有角色缺省都回落到它
LLM_MAX_TOKENS=8192                    # 输出 token 上限（brain + planner 共用）

# ── 模型分层（留空即回落 LLM_MODEL，不配就零行为变化；详见 README「模型分层」）──
LLM_MODEL_BRAIN=                       # 每步决策 + 视觉验证；保持强推理 VLM
LLM_MODEL_PLANNER=                     # 开跑前一次性拆剧本；可用更便宜/快的模型
LLM_MODEL_LOCATOR=                     # 像素级元素定位专用 VLM；**留空 = 关闭元素定位**
                                       #   可选：bytedance/ui-tars-1.5-7b 等 UI-TARS 系（GUI 专用定位），
                                       #   或 Claude/Gemini 某档（如 anthropic/claude-sonnet-5）
LLM_LOCATOR_BASE_URL=                  # 定位模型独立端点；留空复用主 LLM
LLM_LOCATOR_API_KEY=

# ── Agent 行为 ──
AGENT_MAX_STEPS=0                      # 绝对兜底步数；0 = 禁用（靠 per-step 收敛）
AGENT_STEP_DELAY=1.0
AGENT_SPLIT_ACT_CHECK=false            # 分层执行：操作步走元素定位、检查步走大 LLM（需配 LLM_MODEL_LOCATOR）
AGENT_LOCATE_RETRY=2                   # 连续点空几次触发元素定位兜底
AGENT_ASSERT_BURST_FRAMES=3            # settle 关闭时的断言多帧兜底数量；<=1 关闭
AGENT_SETTLE_ENABLED=true              # 等屏幕稳定再决策；断言按变化量自适应发送 1/3 帧
AGENT_SETTLE_TIMEOUT=6.0
AGENT_SETTLE_INTERVAL=0.3
AGENT_SETTLE_STABLE_FRAMES=2
AGENT_WAIT_MAX_S=45                    # 单个 step 的异步等待墙钟预算
AGENT_MERGE_ASSERTS=true               # 连续同屏断言合成一次 LLM 调用并逐条校验

# ── Android ──
ANDROID_SERIAL=                        # 单设备 adb serial；空 = 第一台
ANDROID_PACKAGE=com.example.app        # 被测包名：跑 Android 必填（无默认，缺则报错）

# ── Windows 桌面 ──
# WSL 下会自动使用内置 PowerShell/Win32 runner，Windows 无需安装 Python 或依赖。
WIN_APP=Notepad                        # 目标窗口标题子串
WIN_LAUNCH=notepad.exe                 # 可选；runner 启动并按新进程 PID 锁定窗口

# ── Appium（iOS + Android 统一后端）──
APPIUM_SERVER_URL=                     # 空 = 默认 http://127.0.0.1:4723（argus 自动起/复用）
APPIUM_DEVICE=                         # udid / serial；空 = 按平台取默认
APPIUM_MJPEG_ENABLED=true              # mjpeg 帧流截图（省 HTTP 往返；取不到帧自动回退普通截图）
APPIUM_MJPEG_PORT=                     # 空 = 按设备 serial 派生；多设备并行各自不同端口
APPIUM_MJPEG_QUALITY=90

# ── iOS 真机 WDA 签名（`--platform ios` 真机才需要）──
IOS_TEAM_ID=                           # Apple 开发者 team id（xcodeOrgId，10 位）
IOS_WDA_BUNDLE_ID=com.example.wda
IOS_BUNDLE_ID=

# ── Browser（Selenium：本地 / Grid）──
BROWSER_TYPE=chrome
BROWSER_HEADLESS=false
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=720
SELENIUM_GRID_URL=                     # 如 http://localhost:4444/wd/hub

# ── [实验性/开发中] Remote Desktop / RDP ──
# 当前只验证 Windows RDP；未来用于远程 Windows/macOS 桌面能力。API 与行为可能变化。
# Linux 端安装：sudo apt install freerdp2-x11 xvfb xdotool（新发行版可为 freerdp3-x11）
RDP_HOST=                              # Windows 主机名或 IP；须启用远程桌面
RDP_PORT=3389
RDP_USERNAME=                          # 有密码的 Windows 账户
RDP_PASSWORD=                          # 仅本地 .env；绝不提交
RDP_START_PROGRAM=notepad.exe          # 可选；登录后启动的远程程序
RDP_WIDTH=1280
RDP_HEIGHT=720
RDP_CERTIFICATE=tofu                   # tofu（首次信任、后续证书变更失败）| ignore（仅临时本地 demo）

# ── Figma（可选：生成用例 / 视觉走查）──
FIGMA_TOKEN=
FIGMA_FILE_KEY=

# ── Skills（截图→LLM 间预处理管线）──
SKILLS_ENABLED=loading_detector,keyboard_detector,scroll_map,visual_diff,toast_detector

# ── Probes（非视觉断言插件：埋点 / 后端落库 / 上报日志，见 docs/probes.md）──
# 用例里 `# argus-probe: <name> k=v` 声明的 step 不进 LLM，直接跑插件拿 verdict。
# 插件注册表默认 .argus/probes.json（gitignored，含连接串/密钥）；下面留空即用注册表里的值。
PROBES_CONFIG=                         # 注册表路径（空 = .argus/probes.json）
PROBE_TIMEOUT_S=                       # 一个断言最多等多少秒数据（空 = 300）。
                                       # 埋点批量上报有分钟级延迟，查太早的 0 行不算证据 —— 超预算才判 fail
PROBE_POLL_INTERVAL_S=                 # 重查间隔秒（空 = 20，下限 2）
PROBES_MODE=all                        # all | skip（probe step 标 skip 不验证）|
                                       # only（只跑声明了 probe 的 case，UI 步照跑）
                                       # = argus run --skip-probes / --only-probes
