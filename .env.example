# ── Argus 配置示例 ──────────────────────────────────────────────
# 复制为 .env 后按需填写：  cp .env.example .env
# 真值只放 .env（已 gitignore，绝不入库）。至少填 LLM_API_KEY；跑 Android 还需 ANDROID_PACKAGE。
# 也可 `python3 -m argus.cli init` 生成一份默认 .env。

# ── 平台 ──
PLATFORM=android                       # ios | android | browser

# ── LLM（OpenAI 兼容协议；默认 OpenRouter）──
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=                           # 必填，如 sk-or-v1-...
LLM_MODEL=google/gemini-3.5-flash      # 主多模态模型；所有角色缺省都回落到它
LLM_MAX_TOKENS=8192                    # 输出 token 上限（brain + planner 共用）

# ── 模型分层（留空即回落 LLM_MODEL，不配就零行为变化；详见 README「模型分层」）──
LLM_MODEL_BRAIN=                       # 每步决策 + 视觉验证；保持强推理 VLM
LLM_MODEL_PLANNER=                     # 开跑前一次性拆剧本；可用更便宜/快的模型
LLM_MODEL_GROUNDING=                   # 像素级元素定位专用 VLM；**留空 = 关闭 grounding**
                                       #   可选：bytedance/ui-tars-1.5-7b 等 UI-TARS 系（GUI 专用定位），
                                       #   或 Claude/Gemini 某档（如 anthropic/claude-sonnet-5）
LLM_GROUNDING_BASE_URL=                # grounding 独立端点；留空复用主 LLM
LLM_GROUNDING_API_KEY=

# ── Agent 行为 ──
AGENT_MAX_STEPS=0                      # 绝对兜底步数；0 = 禁用（靠 per-step 收敛）
AGENT_STEP_DELAY=1.0
AGENT_SPLIT_ACT_CHECK=false            # 分层执行：操作步走 grounding、检查步走大 LLM（需配 LLM_MODEL_GROUNDING）
AGENT_GROUNDING_RETRY=2                # 连续点空几次触发 grounding 兜底
AGENT_ASSERT_BURST_FRAMES=3            # 断言步抓几帧做瞬态 UI（toast/banner）检查；<=1 关闭

# ── Android ──
ANDROID_SERIAL=                        # 单设备 adb serial；空 = 第一台
ANDROID_PACKAGE=com.example.app        # 被测包名：跑 Android 必填（无默认，缺则报错）

# ── Appium（iOS + Android 统一后端）──
APPIUM_SERVER_URL=                     # 空 = 默认 http://127.0.0.1:4723（argus 自动起/复用）
APPIUM_DEVICE=                         # udid / serial；空 = 按平台取默认
APPIUM_MJPEG_ENABLED=true              # mjpeg 帧流截图（省 HTTP 往返；取不到帧自动回退普通截图）
APPIUM_MJPEG_PORT=                     # 空 = 按设备 serial 派生；多设备并行各自不同端口
APPIUM_MJPEG_QUALITY=90

# ── iOS 真机 WDA 签名（`--platform ios` 真机才需要）──
IOS_TEAM_ID=                           # Apple 开发者 team id（xcodeOrgId，10 位）
IOS_WDA_BUNDLE_ID=com.example.wda
IOS_BUNDLE_ID=

# ── Browser（Selenium：本地 / Grid）──
BROWSER_TYPE=chrome
BROWSER_HEADLESS=false
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=720
SELENIUM_GRID_URL=                     # 如 http://localhost:4444/wd/hub

# ── Figma（可选：生成用例 / 视觉走查）──
FIGMA_TOKEN=
FIGMA_FILE_KEY=

# ── Skills（截图→LLM 间预处理管线）──
SKILLS_ENABLED=loading_detector,keyboard_detector,scroll_map,visual_diff,toast_detector
