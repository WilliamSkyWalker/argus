include LICENSE README.md pyproject.toml setup.py MANIFEST.in
include scripts/install_agent_plugin.py scripts/install_saygo.py scripts/build_release.py
include scripts/build_desktop.py scripts/package_desktop.py scripts/desktop_windows.spec
recursive-include saygo *.py *.ps1 *.cjs *.md *.json *.txt
recursive-include plugins/saygo-device *.md *.json
include plugins/saygo-device/.mcp.json
include plugins/saygo-device/.codex-plugin/plugin.json
include plugins/saygo-device/.claude-plugin/plugin.json
recursive-include extensions/saygo-browser *.json *.js *.html *.png LICENSE
recursive-include distribution *.md *.json
include docs/desktop.md
prune tests
prune website-project
prune build
prune dist
global-exclude __pycache__ *.py[cod] .env
