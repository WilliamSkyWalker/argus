{
  "manifest_version": 3,
  "name": "Saygo Browser",
  "version": "0.4.9",
  "minimum_chrome_version": "118",
  "description": "Connect your browser tabs to the local Saygo visual engine.",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Saygo Browser"
  },
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "homepage_url": "https://saygo.work/"
}
