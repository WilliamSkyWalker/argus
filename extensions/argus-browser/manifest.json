{
  "manifest_version": 3,
  "name": "Argus Browser",
  "version": "0.3.0",
  "minimum_chrome_version": "118",
  "description": "Connect your browser tabs to the local Argus visual engine.",
  "permissions": ["debugger", "tabs", "storage", "nativeMessaging"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Argus Browser"}
}
